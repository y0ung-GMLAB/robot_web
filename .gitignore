# ROS2 / colcon generated files
build/
install/
log/

# Python generated files
__pycache__/
*.py[cod]
*.pyo

# Local backups and runtime artifacts
backups/
*.bak
*.bak-*
*.tmp
*.log

# User-created project data and the read-only legacy archive. These are moved
# between computers explicitly (USB/import), not with the application source.
/motion_projects/
/motion_data/
/runtime/

# Per-PC robot pack (웹 업로드 · PC 1대 = 로봇 1대) · 이전 팩 · 검사 중 임시
/robot_pack/
/robot_pack.prev/
/robot_pack.incoming/
/robot_pack.swap/

# Per-PC global DDS coordination settings
/config/motion_coordination.yaml
/config/.motion_coordination.yaml.lock
/config/.motion_coordination.yaml.transaction.json
# PC 마다 저장할 때 만들어지는 MINAS param 파일(모터마다 · 수정 목록 113)
/config/minas_params/
# PC 마다 저장할 때 만들어지는 직렬 서보 param 파일(다이나믹셀 · Feetech · 드라이버마다 · 수정 목록 158)
/config/serial_params/
# 이 PC 가 화면에서 바꾼 MINAS 공통 값(기본값은 config/minas_base.yaml · 수정 목록 114)
/config/minas_base.local.yaml

# Local machine files
.vscode/
.idea/
*.swp
*.swo

# Local agent configuration
.agents/
.codex/

# Misc local files
packages.microsoft.gpg
sdo.txt

# Claude Code · 개인 설정은 공유하지 않는다 (프로젝트 공용은 .claude/settings.json)
.claude/settings.local.json

# 루트 임시 파일 · 실험 스크립트·로그는 커밋하지 않는다 (수정 목록 10-4)
/scratch_*
/*_log.txt
